# Copy to .env and adjust as needed. All values shown are the defaults,
# so the app runs fine without any .env file at all.

# Source FHIR server (synthetic-data sandbox; never point at real PHI for this exercise)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Per-request timeout in seconds
FHIR_REQUEST_TIMEOUT=30

# Retry attempts for transient errors (429/5xx/timeouts)
FHIR_MAX_RETRIES=5

# _count used when paginating FHIR bundles
FHIR_PAGE_SIZE=50

# Default patient cap when no --limit / ?limit= is given
MIGRATION_DEFAULT_PATIENT_LIMIT=20

# Patients per observation-fetch Celery task
MIGRATION_BATCH_SIZE=5

# Celery: "true" (default) runs tasks inline with no broker required.
# Set to "false" and run Redis + a worker for true async execution.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
